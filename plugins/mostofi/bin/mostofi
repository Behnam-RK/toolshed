#!/usr/bin/env bash
# On the Bash tool's PATH while the plugin is enabled.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Walk up rather than count `..`; stop when dirname stops moving (`C:/`, `//server`).
while [ ! -d "$here/src/docsteward" ]; do
  parent="$(dirname "$here")"
  [ "$parent" = "$here" ] && break
  here="$parent"
done
if [ ! -d "$here/src/docsteward" ]; then
  echo 'mostofi: cannot find src/docsteward above this shim' >&2
  exit 1
fi

. "$here/scripts/find-python.sh"
find_python || { echo "mostofi: $python_missing" >&2; exit 1; }

exec "$py" -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from docsteward.cli import main; raise SystemExit(main())' \
  "$here/src" "$@"
